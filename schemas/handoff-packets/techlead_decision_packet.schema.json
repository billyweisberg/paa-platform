{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://individual-centricity.local/fractal-core/techlead_decision_packet.schema.json",
  "title": "TechLead Decision Packet",
  "type": "object",
  "required": [
    "message_id",
    "schema_type",
    "schema_version",
    "project",
    "from_role",
    "to_role",
    "created_at",
    "correlation_id",
    "authority_context",
    "github_context",
    "payload"
  ],
  "properties": {
    "message_id": {"type": "string", "minLength": 1},
    "schema_type": {"const": "techlead_decision_packet"},
    "schema_version": {"type": "string", "minLength": 1},
    "project": {"type": "string", "minLength": 1},
    "from_role": {"type": "string", "minLength": 1},
    "to_role": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "correlation_id": {"type": "string", "minLength": 1},
    "github_context": {
      "type": "object",
      "required": ["repo", "issue_number", "pr_number", "branch", "links"],
      "properties": {
        "repo": {"type": "string", "minLength": 1},
        "issue_number": {"type": ["integer", "null"]},
        "pr_number": {"type": ["integer", "null"]},
        "branch": {"type": "string", "minLength": 1},
        "links": {"type": "array", "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": true
    },
    "payload": {
      "type": "object",
      "required": [
        "issue",
        "pr",
        "source_packet_ref",
        "decision_type",
        "decision_rationale",
        "target_role",
        "next_assignment_type",
        "canonical_branch",
        "role_branch",
        "branch_owner_role",
        "lineage_state",
        "lineage_action",
        "source_branch",
        "superseded_branch",
        "worktree_hint",
        "reset_reason",
        "work_item_status_update_intent"
      ],
      "properties": {
        "issue": {"type": "object"},
        "pr": {"type": "object"},
        "source_packet_ref": {"type": "object"},
        "decision_type": {"type": "string", "minLength": 1},
        "decision_rationale": {"type": ["string", "object", "array"]},
        "target_role": {"type": ["string", "null"]},
        "next_assignment_type": {"type": ["string", "null"]},
        "canonical_branch": {"type": "string", "minLength": 1},
        "role_branch": {"type": ["string", "null"]},
        "branch_owner_role": {"type": "string", "minLength": 1},
        "lineage_state": {"type": "string", "minLength": 1},
        "lineage_action": {"type": "string", "minLength": 1},
        "source_branch": {"type": "string", "minLength": 1},
        "superseded_branch": {"type": ["string", "null"]},
        "worktree_hint": {"type": ["string", "null"]},
        "reset_reason": {"type": ["string", "null"]},
        "work_item_status_update_intent": {"type": ["string", "object", "array"]},
        "coder_run_brief_ref": {"type": ["object", "null"]},
        "coder_run_brief": {"type": ["object", "null"]},
        "coder_brief_resolution": {"type": ["object", "null"]}
      },
      "additionalProperties": true
    },
    "authority_context": {
      "type": "object",
      "required": ["manifest_path", "authority_version", "milestone_id", "phase_id", "task_id"],
      "properties": {
        "manifest_path": {"type": "string", "minLength": 1},
        "authority_version": {"type": "string", "minLength": 1},
        "milestone_id": {"type": "string", "minLength": 1},
        "phase_id": {"type": "string", "minLength": 1},
        "task_id": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
