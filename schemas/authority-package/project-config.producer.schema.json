{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://billyweisberg.github.io/paa-platform/schemas/authority-package/project-config.producer.schema.json",
  "title": "PAA Producer Project Config",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project_id",
    "mode",
    "authority_manifest_path",
    "supporting_docs_root",
    "artifact_examples_root",
    "publication_output_root",
    "github_repo"
  ],
  "properties": {
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "const": "producer"
    },
    "authority_manifest_path": {
      "type": "string",
      "minLength": 1
    },
    "supporting_docs_root": {
      "type": "string",
      "minLength": 1
    },
    "artifact_examples_root": {
      "type": "string",
      "minLength": 1
    },
    "publication_output_root": {
      "type": "string",
      "minLength": 1
    },
    "github_repo": {
      "type": "string",
      "minLength": 1
    }
  }
}
